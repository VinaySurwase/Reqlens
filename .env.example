# Copy to .env (git-ignored). Never commit real keys.
RL_DATABASE_URL=postgresql+psycopg://ghost:ghost@localhost:5432/reqlens
RL_GEMINI_API_KEY=
# gemini | hash   (hash = deterministic offline embedder; dev/test only)
RL_EMBEDDING_PROVIDER=gemini
# gemini | heuristic  (heuristic = regex baseline extractor; dev/test/eval-baseline only)
RL_EXTRACTION_PROVIDER=gemini
# VERIFY in official docs before use; kept in config on purpose (spec rule 0.2.3)
RL_GEMINI_LLM_MODEL=gemini-2.5-flash
RL_GEMINI_EMBED_MODEL=gemini-embedding-001
RL_EMBED_DIM=768
